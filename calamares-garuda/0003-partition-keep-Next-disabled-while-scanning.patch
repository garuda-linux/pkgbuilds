 void
+ChoicePage::runScan( const QFuture< void >& future, const std::function< void() >& callback, QWidget* parent )
+{
+    ++m_scansRunning;
+    updateNextEnabled();
+    ScanningDialog::run(
+        future,
+        [ this, callback ]
+        {
+            callback();
+            --m_scansRunning;
+            updateNextEnabled();
+        },
