From 67599067ef2071be26c1d1505131c979665ced12 Mon Sep 17 00:00:00 2001
From: Nico <dr460nf1r3@garudalinux.org>
Date: Fri, 7 Aug 2026 18:41:08 +0200
Subject: [PATCH 8/8] partition: Use the drive's optimal sector size when
 formatting

When creating new partitions (e.g. erase/replace/manual), pick the
largest sector size the device supports -- the max of the logical and
physical sector size -- instead of always using the logical sector
size. Advanced Format drives report a 512-byte logical sector size
while supporting 4096-byte sectors; formatting with the larger size
is what the drive natively supports. The LUKS container and its
inner filesystem inherit the same optimal sector size.
---
 src/modules/partition/core/KPMHelpers.cpp | 23 +++++++++++++++++++++--
 src/modules/partition/core/KPMHelpers.h   | 10 ++++++++++
 2 files changed, 31 insertions(+), 2 deletions(-)

diff --git a/src/modules/partition/core/KPMHelpers.cpp b/src/modules/partition/core/KPMHelpers.cpp
index 2b81d145f..412df7c0d 100644
--- a/src/modules/partition/core/KPMHelpers.cpp
+++ b/src/modules/partition/core/KPMHelpers.cpp
@@ -19,6 +19,7 @@

 #include <kpmcore/backend/corebackendmanager.h>
 #include <kpmcore/core/device.h>
+#include <kpmcore/core/diskdevice.h>
 #include <kpmcore/core/partition.h>
 #include <kpmcore/fs/filesystem.h>
 #include <kpmcore/fs/filesystemfactory.h>
@@ -28,6 +29,8 @@

 #include <qregularexpression.h>

+#include <algorithm>
+
 using Calamares::Partition::PartitionIterator;

 namespace KPMHelpers
@@ -49,6 +52,22 @@ findPartitionByMountPoint( const QList< Device* >& devices, const QString& mount
     return nullptr;
 }

+qint64
+sectorSizeForDevice( const Device& device )
+{
+    qint64 sectorSize = device.logicalSize();
+    const auto* diskDevice = dynamic_cast< const DiskDevice* >( &device );
+    if ( diskDevice )
+    {
+        const qint64 physicalSectorSize = diskDevice->physicalSectorSize();
+        if ( physicalSectorSize > 0 )
+        {
+            sectorSize = std::max( sectorSize, physicalSectorSize );
+        }
+    }
+    return sectorSize;
+}
+

 Partition*
 createNewPartition( PartitionNode* parent,
@@ -60,7 +79,7 @@ createNewPartition( PartitionNode* parent,
                     qint64 lastSector,
                     PartitionTable::Flags flags )
 {
-    FileSystem* fs = FileSystemFactory::create( fsType, firstSector, lastSector, device.logicalSize() );
+    FileSystem* fs = FileSystemFactory::create( fsType, firstSector, lastSector, sectorSizeForDevice( device ) );
     fs->setLabel( fsLabel );
     return new Partition( parent,
                           device,
@@ -98,7 +117,7 @@ createNewEncryptedPartition( PartitionNode* parent,
     FileSystem::Type luksType = luksGenerationToFSName( luksFsType );

     FS::luks* fs = dynamic_cast< FS::luks* >(
-        FileSystemFactory::create( luksType, firstSector, lastSector, device.logicalSize() ) );
+        FileSystemFactory::create( luksType, firstSector, lastSector, sectorSizeForDevice( device ) ) );
     if ( !fs )
     {
         cError() << "cannot create LUKS filesystem. Giving up.";
diff --git a/src/modules/partition/core/KPMHelpers.h b/src/modules/partition/core/KPMHelpers.h
index b8e6fca18..0cc2edac8 100644
--- a/src/modules/partition/core/KPMHelpers.h
+++ b/src/modules/partition/core/KPMHelpers.h
@@ -64,6 +64,16 @@ enum class SavePassphraseValue
  */
 Partition* findPartitionByMountPoint( const QList< Device* >& devices, const QString& mountPoint );

+/** @brief The largest (optimal) sector size the device supports
+ *
+ * For physical disks this is the larger of the logical and the physical
+ * sector size reported by the device (e.g. 4096 on Advanced Format
+ * drives that report a 512-byte logical sector size). For other device
+ * types, or when the physical sector size is unknown, the device's
+ * logical sector size is used.
+ */
+qint64 sectorSizeForDevice( const Device& device );
