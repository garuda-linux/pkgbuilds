# Maintainer: dr460nf1r3 <dr460nf1r3 at garudalinux dot org>
# Contributor: Librewish <librewish@gmail.com>

pkgname=garuda-backgrounds
pkgver=1.0.0
pkgrel=1
_commit='16164df3029000ebdf0039161f458a003815a5f5'
pkgdesc="Garuda's default wallpaper collection for GNOME"
arch=('any')
url="https://gitlab.com/garuda-linux/themes-and-settings/artwork/$pkgname"
license=('GPLv3')

source=("https://gitlab.com/garuda-linux/themes-and-settings/artwork/garuda-backgrounds/-/archive/${_commit}/garuda-backgrounds-${_commit}.tar.gz")
sha256sums=('SKIP')


package() {
	cd "${pkgname}-$_commit" || exit
	install -d "${pkgdir}/usr/share/backgrounds/${pkgname}"
	cp "${srcdir}/${pkgname}-$_commit/src/${pkgname}"/*.{png,jpg} "${pkgdir}/usr/share/backgrounds/${pkgname}"

	install -d "${pkgdir}/usr/share/gnome-background-properties"
	cp "${srcdir}/${pkgname}-$_commit/src/${pkgname}/${pkgname}.xml" "${pkgdir}/usr/share/gnome-background-properties/garuda-backgrounds.xml"
}
