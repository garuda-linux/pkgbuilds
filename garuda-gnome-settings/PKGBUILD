pkgname=garuda-gnome-settings
pkgver="1.6.0"
_commit='062659fcc3de8dd0ace3926c7b1bc68ecf6f035e'
pkgrel=1
arch=('any')
url="https://gitlab.com/garuda-linux/themes-and-settings/settings/$pkgname"
license=('GPL')
source=("https://gitlab.com/garuda-linux/themes-and-settings/settings/garuda-gnome-settings/-/archive/${_commit}/garuda-gnome-settings-${_commit}.tar.gz")
sha256sums=('2018e3a7816f0c855bf20f07df33ec7fc99d7cafd334e284c726eec1ef937297')
pkgdesc='Garuda Linux GNOME settings'
install=$pkgname.install
depends=('garuda-backgrounds'
  'garuda-common-settings'
  'gnome-themes-extra'
  'kvantum')
provides=('garuda-desktop-settings')
conflicts=('garuda-desktop-settings')

package() {
  cp -rf "$srcdir"/$pkgname-$_commit/{etc,usr} "$pkgdir"
  install -Dm644 "${srcdir}/$pkgname-$_commit/zz_garuda-gnome-settings.gschema.override" "${pkgdir}/usr/share/glib-2.0/schemas/zz_garuda-gnome-settings.gschema.override"
}
