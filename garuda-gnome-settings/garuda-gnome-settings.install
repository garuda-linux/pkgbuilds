post_upgrade() {
	if [ "$(vercmp "$2" 1.5.10)" -le 0 ]; then
		cat <<'EOF'
==> garuda-gnome-settings no longer depends on ttf-fira-sans and ttf-firacode-nerd.
    New users get GNOME's default fonts, Adwaita Sans and Adwaita Mono.
    Accounts set up by an older version still use the Fira fonts. Either keep them:
      sudo pacman -D --asexplicit ttf-fira-sans ttf-firacode-nerd
    or switch each account to the GNOME defaults, as that user:
      gsettings reset org.gnome.desktop.interface font-name
      gsettings reset org.gnome.desktop.interface document-font-name
      gsettings reset org.gnome.desktop.interface monospace-font-name
      gsettings reset org.gnome.desktop.wm.preferences titlebar-font
    Without either, removing orphaned packages also removes the fonts.
EOF
	fi
}
