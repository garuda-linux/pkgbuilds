pkgname=garuda-icons
pkgdesc="Base icons for Garuda Linux"
pkgver=1.0.0
pkgrel=1
_commit='17e1dfa085c19bead800469f3c7b291a681039f1'
arch=('any')
url="https://gitlab.com/garuda-linux/themes-and-settings/artwork/$pkgname"
license=('GPL')

source=("https://gitlab.com/garuda-linux/themes-and-settings/artwork/garuda-icons/-/archive/${_commit}/garuda-icons-${_commit}.tar.gz")
sha256sums=('SKIP')

package() {
  install -d "$pkgdir"/usr
  cp -rf "$srcdir"/$pkgname-$_commit/usr "$pkgdir"
}
