#!/bin/bash
set -e

# Elevate once and stop asking for the password constantly
if [[ $EUID -ne 0 ]]; then
    exec sudo /usr/bin/garuda-nix-subsystem "$@"
    exit 1
fi

# Switch case $1
case $1 in
    "install")
        exec /usr/lib/garuda/garuda-nix-subsystem/installer "${@:2}"
        ;;
    "" | "update")
        exec /usr/lib/garuda/garuda-nix-subsystem/updater
        ;;
    "uninstall")
        exec /usr/lib/garuda/garuda-nix-subsystem/uninstaller "${@:2}"
        ;;
    *)
        echo "Unknown command: $1"
        exit 1
        ;;
esac