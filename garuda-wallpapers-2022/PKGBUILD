# Maintainer: dr460nf1r3 <dr460nf1r3 at garudalinux dot org>

pkgname=garuda-wallpapers-2022
pkgver=1.0.0
pkgrel=1
_commit='e764a724be19dd81a376e0395dd2d1035e8c52b4'
pkgdesc="Garuda's wallpaper collection, 2022 edition"
arch=('any')
url="https://gitlab.com/garuda-linux/themes-and-settings/artwork/garuda-wallpapers-2022"
license=('GPLv3')

depends=()
source=("https://gitlab.com/garuda-linux/themes-and-settings/artwork/garuda-wallpapers-2022/-/archive/${_commit}/garuda-wallpapers-2022-${_commit}.tar.gz")
sha256sums=('SKIP')


package() {
	cd "${pkgname}-$_commit" || exit
	install -d "${pkgdir}/usr/share/wallpapers/garuda-wallpapers"
	cp -r src/garuda-wallpapers/* "${pkgdir}/usr/share/wallpapers/garuda-wallpapers"
}
