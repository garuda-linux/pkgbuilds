pkgname=garuda-wallpapers-honeycombs
pkgver=1.0.0
pkgrel=1
_commit='5af5ec5cb14c8ec7e78a5cf2b18027cdc2fcb602'
pkgdesc="Garuda's wallpaper collection, honeycombs edition"
arch=('any')
url="https://gitlab.com/garuda-linux/themes-and-settings/artwork/garuda-wallpapers-honeycombs"
license=('GPLv3')

depends=()
source=("https://gitlab.com/garuda-linux/themes-and-settings/artwork/garuda-wallpapers-honeycombs/-/archive/${_commit}/garuda-wallpapers-honeycombs-${_commit}.tar.gz")
sha256sums=('SKIP')

package() {
  cd "${pkgname}-$_commit" || exit
  install -d "${pkgdir}/usr/share/wallpapers/garuda-wallpapers"
  cp "${srcdir}/${pkgname}-$_commit"/src/* "${pkgdir}/usr/share/wallpapers/garuda-wallpapers"
}
