# Maintainer: dr460nf1r3 <dr460nf1r3 at garudalinux dot org>

pkgname=garuda-wallpapers
pkgver=1.1.1
pkgrel=1
_commit='a0f808475c4854c90d340b3959d7733b95bbfd20'
pkgdesc="Garuda's default wallpaper collection"
arch=('any')
url="https://gitlab.com/garuda-linux/themes-and-settings/artwork/$pkgname"
license=('GPLv3')

source=("https://gitlab.com/garuda-linux/themes-and-settings/artwork/garuda-wallpapers/-/archive/${_commit}/garuda-wallpapers-${_commit}.tar.gz")
sha256sums=('SKIP')

package() {
  cd "${pkgname}-$_commit" || exit
  install -d "${pkgdir}/usr/share/wallpapers/${pkgname}"
  cp "${srcdir}/${pkgname}-$_commit/src/${pkgname}"/* "${pkgdir}/usr/share/wallpapers/${pkgname}"
}
