pkgbase = input-devices-support
	pkgdesc = Meta package for input devices support
	pkgver = 1.1.0
	pkgrel = 1
	url = https://wiki.archlinux.org/index.php/Category:Input_devices
	install = input-devices-support.install
	arch = any
	license = GPL
	depends = android-udev
	depends = bolt
	depends = brightnessctl
	depends = fprintd
	depends = game-devices-udev
	depends = iio-sensor-proxy
	depends = linuxconsole
	depends = lirc
	depends = v4l-utils
	optdepends = piper: GTK application to configure gaming mice
	optdepends = antimicrox: GUI for mapping keyboard keys to controller
	optdepends = plasma-thunderbolt: Plasma integration for managing Thunderbolt devices

pkgname = input-devices-support
