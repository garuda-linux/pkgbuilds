pkgname="plymouth-theme-dr460nized"
pkgdesc="Plymouth theme for Garuda dr460nized"
pkgver=1.0.0
pkgrel=3
_commit='f7f946a2c7c8facd3e012ec84b34e15e1292388b'
arch=("any")
url="https://gitlab.com/garuda-linux/themes-and-settings/artwork/$pkgname"
license=("GPL")
source=("https://gitlab.com/garuda-linux/themes-and-settings/artwork/plymouth-theme-dr460nized/-/archive/${_commit}/plymouth-theme-dr460nized-${_commit}.tar.gz")
sha256sums=("SKIP")
install="$pkgname".install

package() {
  install -d "$pkgdir/usr/share/plymouth/themes/dr460nized"
  cp -rf "$srcdir/$pkgname-$_commit/usr" "$pkgdir"
}
