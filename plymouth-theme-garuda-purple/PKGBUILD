pkgname="plymouth-theme-garuda-purple"
pkgdesc="The default Plymouth theme for Garuda Linux - purple version"
pkgver=1.0.0
pkgrel=3
_commit='5e40449084e6ac4402829ac100ba95a8648c8336'
arch=("any")
url="https://gitlab.com/garuda-linux/themes-and-settings/artwork/$pkgname"
license=("GPL")
source=("https://gitlab.com/garuda-linux/themes-and-settings/artwork/plymouth-theme-garuda-purple/-/archive/${_commit}/plymouth-theme-garuda-purple-${_commit}.tar.gz")
sha256sums=("SKIP")
install="$pkgname".install

package() {
  install -d "$pkgdir/usr/share/plymouth/themes/garuda-purple"
  cp -rf "$srcdir/$pkgname-$_commit/usr" "$pkgdir"
}
