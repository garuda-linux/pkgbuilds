pkgname="plymouth-theme-garuda"
pkgdesc="The default Plymouth theme for Garuda Linux"
pkgver=1.0.0
pkgrel=3
_commit='0ced58741d7cb7182ed6dd9d79393b55aaa98ce6'
arch=("any")
url="https://gitlab.com/garuda-linux/themes-and-settings/artwork/$pkgname"
license=("GPL")
source=("https://gitlab.com/garuda-linux/themes-and-settings/artwork/plymouth-theme-garuda/-/archive/${_commit}/plymouth-theme-garuda-${_commit}.tar.gz")
sha256sums=("SKIP")
install=$pkgname.install

package() {
  install -d "$pkgdir/usr/share/plymouth/themes/garuda"
  cp -rf "$srcdir/$pkgname-$_commit/usr" "$pkgdir"
}
