pkgname="plymouth-theme-mokka"
pkgdesc="Plymouth theme for Garuda Mokka"
pkgver=1.0.0
pkgrel=1
_commit='e46024d1d8923a037e97373245007e864199716e'
arch=("any")
url="https://gitlab.com/garuda-linux/themes-and-settings/artwork/$pkgname"
license=("GPL")
source=("https://gitlab.com/garuda-linux/themes-and-settings/artwork/plymouth-theme-mokka/-/archive/${_commit}/plymouth-theme-mokka-${_commit}.tar.gz")
sha256sums=("SKIP")
install="$pkgname".install


package() {
	install -d "$pkgdir/usr/share/plymouth/themes/mokka"
	cp -rf "$srcdir/$pkgname-$_commit/usr" "$pkgdir"
}
