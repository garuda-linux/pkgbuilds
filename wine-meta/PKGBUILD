pkgname=wine-meta
pkgver=2
pkgrel=4
arch=('any')
url="https://wiki.archlinux.org/index.php/wine"
license=('GPL')
pkgdesc="Meta-package for WINE support"

package() {
  conflicts=(
    # https://forum.garudalinux.org/t/48812
    # Specifically add this package only so auto-pacman can resolve
    # the conflict with lib32-fluidsynth during update. The rest
    # of the remaining lib32 packages should be removed as orphans.
    lib32-fluidsynth
    # The same goes for these (https://forum.garudalinux.org/t/49193)
    lib32-audit
    lib32-libcap
  )
  depends=(
    alsa-lib
    alsa-oss
    alsa-plugins
    fluidsynth
    giflib
    gnutls
    gst-plugins-base-libs
    gtk3
    icoextract
    icoutils
    libgcrypt
    libgpg-error
    libjpeg-turbo
    libldap
    libpng
    libpulse
    libva
    libxcomposite
    libxinerama
    libxslt
    mpg123
    ncurses
    openal
    opencl-icd-loader
    sdl2
    sqlite
    v4l-utils
    vkd3d
    vulkan-icd-loader
    wine
    wine-gecko
    wine-installer
    wine-mono
    wineasio
    winetricks
  )
}
